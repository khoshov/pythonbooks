# =============================================
# БАЗОВЫЕ НАСТРОЙКИ DJANGO
# =============================================
DEBUG=True
SECRET_KEY=supersecretkey
DJANGO_SECRET_KEY=supersecretkey
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# =============================================
# БАЗА ДАННЫХ (PostgreSQL)
# =============================================
POSTGRES_DB=pythonbooks
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres

# =============================================
# LLM API (для сбора регалий авторов)
# =============================================
LLM_PROVIDER=deepseek  # Options: deepseek, openai

# DeepSeek API (рекомендуется - дешевле)
# Получить ключ: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key

# OpenAI API (альтернатива)
OPENAI_API_KEY=sk-your-openai-api-key

# =============================================
# SERPAPI (для поиска информации об авторах)
# Опционально, но рекомендуется для лучших результатов
# Получить ключ: https://serpapi.com/
# =============================================
SERPAPI_KEY=your-serpapi-key
